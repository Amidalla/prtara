{% set title = "Пром Регион Тара" %}
{% from "components/general/logo/logo.njk" import render as logo %}
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ title }} — карта страниц</title>
        <style>
            @font-face {
                font-family: "Golos Text";
                font-style: normal;
                font-weight: 400;
                src: url("./assets/fonts/GolosText-Regular.ttf") format("truetype");
                font-display: swap;
            }

            @font-face {
                font-family: "Golos Text";
                font-style: normal;
                font-weight: 600;
                src: url("./assets/fonts/GolosText-SemiBold.ttf") format("truetype");
                font-display: swap;
            }

            :root {
                --white: #fff;
                --blue: #134a9b;
                --blue-dark: #0d3979;
                --red: #b52f59;
                --black: #37383a;
                --gray: #f2f2f2;
            }

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: "Golos Text", sans-serif;
                color: var(--black);
                background: var(--gray);
            }

            .background {
                position: fixed;
                inset: 0;
                z-index: -1;
                overflow: hidden;
                background:
                    linear-gradient(90deg, rgb(255 255 255 / 94%) 0%, rgb(255 255 255 / 72%) 54%, rgb(19 74 155 / 24%) 100%),
                    url("https://images.unsplash.com/photo-1586864387789-628af9feed72?auto=format&fit=crop&w=1800&q=85") center / cover;
            }

            .background::before,
            .background::after {
                position: absolute;
                content: "";
                border-radius: 50%;
                filter: blur(2px);
            }

            .background::before {
                top: -220px;
                right: -160px;
                width: 600px;
                height: 600px;
                background: rgb(181 47 89 / 26%);
            }

            .background::after {
                bottom: -260px;
                left: -140px;
                width: 520px;
                height: 520px;
                background: rgb(19 74 155 / 18%);
            }

            .page {
                width: min(100%, 1446px);
                padding: 48px 30px 72px;
                margin: 0 auto;
            }

            .hero {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(250px, 360px);
                gap: 32px;
                align-items: end;
                margin-bottom: 36px;
            }

            .brand {
                display: inline-flex;
                align-items: center;
                text-decoration: none;
            }

            .brand .logo svg {
                display: block;
                width: 159px;
                height: auto;
            }

            h1 {
                max-width: 760px;
                margin: 26px 0 10px;
                font-size: clamp(38px, 5vw, 64px);
                font-weight: 600;
                line-height: 110%;
                color: var(--blue);
            }

            .intro {
                max-width: 630px;
                margin: 0;
                font-size: 18px;
                line-height: 140%;
            }

            .groups {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 20px;
            }

            .group {
                padding: 22px;
                background: rgb(255 255 255 / 94%);
                border: 1px solid rgb(19 74 155 / 16%);
                box-shadow: 0 10px 24px rgb(19 74 155 / 9%);
                backdrop-filter: blur(8px);
            }

            .group--main {
                grid-column: span 2;
            }

            .group-title {
                display: flex;
                gap: 10px;
                align-items: center;
                margin: 0 0 16px;
                font-size: 18px;
                font-weight: 600;
                color: var(--blue);
            }

            .group-title::before {
                width: 10px;
                height: 10px;
                content: "";
                background: var(--red);
            }

            .list {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
                padding: 0;
                margin: 0;
                list-style: none;
            }

            .group--catalog .list,
            .group--system .list {
                grid-template-columns: 1fr;
            }

            .list a {
                display: flex;
                gap: 12px;
                align-items: center;
                justify-content: space-between;
                min-height: 82px;
                padding: 14px 16px;
                color: var(--black);
                text-decoration: none;
                background: var(--gray);
                border: 1px solid transparent;
                transition:
                    color 0.25s ease,
                    border-color 0.25s ease,
                    background-color 0.25s ease,
                    transform 0.25s ease;
            }

            .list a:hover {
                color: var(--blue);
                background: var(--white);
                border-color: var(--blue);
                transform: translateY(-2px);
            }

            .name {
                display: block;
                font-size: 16px;
                font-weight: 600;
                line-height: 130%;
            }

            .file {
                display: block;
                margin-top: 4px;
                font-size: 13px;
                font-weight: 400;
                color: rgb(55 56 58 / 60%);
            }

            .arrow {
                flex: 0 0 auto;
                color: var(--red);
                font-size: 24px;
                line-height: 1;
            }

            .footer {
                display: flex;
                gap: 18px;
                align-items: center;
                justify-content: space-between;
                padding-top: 22px;
                margin-top: 28px;
                border-top: 1px solid rgb(19 74 155 / 22%);
            }

            .footer p {
                margin: 0;
                font-size: 14px;
            }

            .footer a {
                padding: 10px 16px;
                color: var(--white);
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                background: var(--blue);
                transition: background-color 0.25s ease;
            }

            .footer a:hover {
                background: var(--blue-dark);
            }

            @media (max-width: 1023px) {
                .groups {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .group--main {
                    grid-column: span 2;
                }
            }

            @media (max-width: 767px) {
                .page {
                    padding: 30px 15px 48px;
                }

                .hero,
                .groups {
                    grid-template-columns: 1fr;
                }

                .hero {
                    gap: 18px;
                    margin-bottom: 24px;
                }


                .group--main {
                    grid-column: auto;
                }

                .list {
                    grid-template-columns: 1fr;
                }

                .footer {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }
        </style>
    </head>
    <body>
        <div class="background" aria-hidden="true"></div>
        <main class="page">
            <section class="hero">
                <div>
                    <div class="brand">{{ logo() }}</div>
                    <h1>Карта страниц</h1>
                    <p class="intro">Навигация по макетам сайта упаковки и упаковочных материалов «Пром Регион Тара».</p>
                </div>
            </section>

            {% macro pageLink(title, file) %}
                <li>
                    <a href="./{{ file }}">
                        <span><span class="name">{{ title }}</span><span class="file">{{ file }}</span></span>
                        <span class="arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            {% endmacro %}

            <div class="groups">
                <section class="group group--main">
                    <h2 class="group-title">Основные страницы</h2>
                    <ul class="list">
                        {{ pageLink("Главная", "home.html") }}
                        {{ pageLink("О компании", "about.html") }}
                        {{ pageLink("Сертификаты", "certificates.html") }}
                        {{ pageLink("Контакты", "contacts.html") }}
                        {{ pageLink("Доставка и оплата", "delivery.html") }}
                        {{ pageLink("Акции", "promotions.html") }}
                    </ul>
                </section>

                <section class="group group--catalog">
                    <h2 class="group-title">Каталог</h2>
                    <ul class="list">
                        {{ pageLink("Каталог", "catalog.html") }}
                        {{ pageLink("Каталог — 2 уровень", "catalog-category.html") }}
                        {{ pageLink("Карточка товара", "product.html") }}
                    </ul>
                </section>

                <section class="group group--system">
                    <h2 class="group-title">Служебные</h2>
                    <ul class="list">
                        {{ pageLink("Поисковая выдача", "search.html") }}
                        {{ pageLink("Политика конфиденциальности", "policy.html") }}
                        {{ pageLink("Ошибка 404", "error-404.html") }}
                    </ul>
                </section>
            </div>

            <footer class="footer">
                <p>Карта страниц для разработки сайта</p>
                <a href="./home.html">Открыть главную</a>
            </footer>
        </main>
    </body>
</html>
