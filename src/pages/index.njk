{% set title = "Prtara" }
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ title }} — карта страниц</title>
        <style>
            @font-face {
                font-family: Nunito;
                font-style: normal;
                font-weight: 500;
                src: url("./assets/fonts/Nunito-Medium.ttf") format("truetype");
                font-display: swap;
            }

            @font-face {
                font-family: Nunito;
                font-style: normal;
                font-weight: 600;
                src: url("./assets/fonts/Nunito-SemiBold.ttf") format("truetype");
                font-display: swap;
            }

            @font-face {
                font-family: Nunito;
                font-style: normal;
                font-weight: 700;
                src: url("./assets/fonts/Nunito-Bold.ttf") format("truetype");
                font-display: swap;
            }

            :root {
                --color-white: #fff;
                --color-blue: #055faa;
                --color-blue-light: #63a7ff;
                --color-1: #061e49;
                --color-2: #eff2f6;
                --color-3: #2c2a68;
                --font: "Nunito", sans-serif;
            }

            * {
                box-sizing: border-box;
            }

            body {
                position: relative;
                min-height: 100vh;
                margin: 0;
                font-family: var(--font);
                color: var(--color-white);
                background: #061e49;
            }

            .bg {
                position: fixed;
                inset: 0;
                z-index: 0;
                overflow: hidden;
                pointer-events: none;
            }

            .bg-main {
                position: absolute;
                inset: 0;
                background:
                    linear-gradient(326deg, rgb(5 82 150 / 82%) 5.47%, rgb(6 30 73 / 92%) 81.31%),
                    url("./assets/images/content/about-short-bg.jpg") center / cover no-repeat;
            }

            .bg-orb {
                position: absolute;
                border-radius: 50%;
                filter: blur(2px);
                opacity: 0.55;
            }

            .bg-orb-1 {
                top: -8%;
                right: -6%;
                width: min(52vw, 620px);
                height: min(52vw, 620px);
                background:
                    linear-gradient(160deg, rgb(6 30 73 / 35%) 0%, rgb(5 95 170 / 55%) 100%),
                    url("./assets/images/content/advantages-bg.jpg") center / cover no-repeat;
            }

            .bg-orb-2 {
                bottom: -12%;
                left: -8%;
                width: min(48vw, 540px);
                height: min(48vw, 540px);
                background:
                    linear-gradient(200deg, rgb(6 30 73 / 45%) 0%, rgb(5 95 170 / 50%) 100%),
                    url("./assets/images/content/we-are-working.jpg") center / cover no-repeat;
            }

            .bg-panel {
                position: absolute;
                overflow: hidden;
                border: 1px solid rgb(255 255 255 / 16%);
                border-radius: 20px;
                box-shadow: 0 20px 50px rgb(6 30 73 / 35%);
                opacity: 0.4;
            }

            .bg-panel img {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .bg-panel-1 {
                top: 12%;
                right: 4%;
                width: min(22vw, 260px);
                height: min(28vw, 320px);
                transform: rotate(6deg);
            }

            .bg-panel-2 {
                right: 8%;
                bottom: 10%;
                width: min(20vw, 220px);
                height: min(16vw, 170px);
                transform: rotate(-8deg);
            }

            .page {
                position: relative;
                z-index: 1;
                max-width: 1120px;
                padding: 56px 40px 72px;
                margin: 0 auto;
            }

            .page::before {
                position: absolute;
                right: -40px;
                bottom: -80px;
                z-index: 0;
                font-size: clamp(280px, 40vw, 420px);
                font-weight: 700;
                line-height: 0.8;
                color: rgb(99 167 255 / 8%);
                pointer-events: none;
                content: "A";
                user-select: none;
            }

            .header {
                position: relative;
                z-index: 1;
                margin-bottom: 48px;
            }

            .brand {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .logo {
                display: inline-flex;
                color: var(--color-white);
                text-decoration: none;
                transition: opacity 0.2s ease;
            }

            .logo:hover {
                opacity: 0.85;
            }

            .logo svg {
                display: block;
                width: min(100%, 197px);
                height: auto;
            }

            .intro {
                max-width: 520px;
            }

            h1 {
                margin: 0 0 12px;
                font-size: clamp(28px, 4vw, 40px);
                font-weight: 500;
                line-height: 120%;
                text-transform: uppercase;
            }

            h1::after {
                display: block;
                width: 53px;
                height: 3px;
                margin-top: 12px;
                content: "";
                background: var(--color-blue-light);
            }

            .intro p {
                margin: 0;
                font-size: 16px;
                font-weight: 500;
                line-height: 150%;
                color: rgb(255 255 255 / 78%);
            }

            .groups {
                position: relative;
                z-index: 1;
                display: grid;
                gap: 28px;
            }

            .group {
                padding: 28px;
                background: rgb(255 255 255 / 8%);
                border: 1px solid rgb(255 255 255 / 14%);
                border-radius: 20px;
                backdrop-filter: blur(10px);
            }

            .group-title {
                margin: 0 0 18px;
                font-size: 14px;
                font-weight: 700;
                line-height: 120%;
                color: var(--color-blue-light);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .list {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
                align-items: stretch;
                padding: 0;
                margin: 0;
                list-style: none;
            }

            .list li {
                display: flex;
                min-height: 100%;
            }

            .list a {
                position: relative;
                display: flex;
                flex: 1 1 auto;
                gap: 16px;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                min-height: 104px;
                padding: 18px 20px;
                color: var(--color-white);
                font-size: 16px;
                font-weight: 700;
                line-height: 120%;
                text-decoration: none;
                background: rgb(6 30 73 / 35%);
                border: 1px solid rgb(255 255 255 / 12%);
                border-radius: 12px;
                transition:
                    background-color 0.25s ease,
                    border-color 0.25s ease,
                    transform 0.25s ease,
                    box-shadow 0.25s ease;
            }

            .list a:hover {
                background: rgb(5 95 170 / 55%);
                border-color: rgb(99 167 255 / 45%);
                box-shadow: 0 12px 28px rgb(5 95 170 / 28%);
                transform: translateY(-2px);
            }

            .list a:focus-visible {
                outline: 2px solid var(--color-blue-light);
                outline-offset: 2px;
            }

            .list .label {
                display: flex;
                flex-direction: column;
                gap: 4px;
                min-width: 0;
            }

            .list .name {
                text-transform: uppercase;
            }

            .list .file {
                font-size: 12px;
                font-weight: 500;
                line-height: 120%;
                color: rgb(255 255 255 / 55%);
                text-transform: none;
            }

            .list .icon {
                display: inline-flex;
                flex: 0 0 auto;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                color: var(--color-blue-light);
                border: 1px solid rgb(255 255 255 / 28%);
                border-radius: 10px;
                transition:
                    color 0.25s ease,
                    border-color 0.25s ease,
                    background-color 0.25s ease;
            }

            .list a:hover .icon {
                color: var(--color-white);
                background: rgb(99 167 255 / 20%);
                border-color: rgb(99 167 255 / 50%);
            }

            .list .icon svg {
                display: block;
                width: 18px;
                height: 18px;
            }

            .footer {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                gap: 12px 24px;
                align-items: center;
                justify-content: space-between;
                margin-top: 32px;
                padding-top: 24px;
                border-top: 1px solid rgb(255 255 255 / 14%);
            }

            .footer p {
                margin: 0;
                font-size: 14px;
                font-weight: 500;
                line-height: 150%;
                color: rgb(255 255 255 / 65%);
            }

            .footer a {
                color: var(--color-blue-light);
                font-weight: 600;
                text-decoration: none;
            }

            .footer a:hover {
                text-decoration: underline;
            }

            @media (width <= 900px) {
                .list {
                    grid-template-columns: 1fr;
                }

                .bg-panel {
                    display: none;
                }
            }

            @media (width <= 600px) {
                .page {
                    padding: 32px 16px 48px;
                }

                .header {
                    margin-bottom: 32px;
                }

                .group {
                    padding: 20px 16px;
                    border-radius: 16px;
                }

                .list a {
                    min-height: 96px;
                    padding: 14px 16px;
                    font-size: 14px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .list a,
                .list .icon,
                .logo {
                    transition: none;
                }

                .list a:hover {
                    transform: none;
                }
            }
        </style>
    </head>
