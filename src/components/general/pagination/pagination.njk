{% macro render(
        items=[],
        class="",
        aria={}
    ) %}
    {% set paginationClasses = "pagination" %}
    {% if class %}
        {% set paginationClasses = paginationClasses + " " + class %}
    {% endif %}

    {% set pagArrowIcon %}
        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 15" fill="none" aria-hidden="true">
            <path
                d="M1 14L7.21084 8.23279C7.6369 7.83716 7.6369 7.16284 7.21084 6.76721L1 1"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            />
        </svg>
    {% endset %}

    <nav
        class="{{ paginationClasses }}"
        {% if aria %}
            {% for key, val in aria %}
                aria-{{ key | replace("_", "-") }}="{{ val }}"
            {% endfor %}
        {% endif %}
        {% if not aria.label %}aria-label="Пагинация"{% endif %}
    >
        {% for item in items %}
            {% set desktopOnlyClass = " is-desktop-only" if item.desktopOnly else "" %}

            {% if item.type == "prev" %}
                {% if item.disabled %}
                    <span class="pag-arrow prev is-disabled{{ desktopOnlyClass }}" aria-disabled="true" aria-label="Назад">
                        <span class="pag-arrow-icon">{{ pagArrowIcon | safe }}</span>
                    </span>
                {% else %}
                    <a class="pag-arrow prev{{ desktopOnlyClass }}" href="{{ item.url }}" aria-label="Назад">
                        <span class="pag-arrow-icon">{{ pagArrowIcon | safe }}</span>
                    </a>
                {% endif %}
            {% elif item.type == "next" %}
                {% if item.disabled %}
                    <span class="pag-arrow next is-disabled{{ desktopOnlyClass }}" aria-disabled="true" aria-label="Вперёд">
                        <span class="pag-arrow-icon">{{ pagArrowIcon | safe }}</span>
                    </span>
                {% else %}
                    <a class="pag-arrow next{{ desktopOnlyClass }}" href="{{ item.url }}" aria-label="Вперёд">
                        <span class="pag-arrow-icon">{{ pagArrowIcon | safe }}</span>
                    </a>
                {% endif %}
            {% elif item.type == "ellipsis" %}
                <span class="pag-item ellipsis{{ desktopOnlyClass }}">...</span>
            {% elif item.active %}
                <span class="pag-item is-active{{ desktopOnlyClass }}" aria-current="page">{{ item.number }}</span>
            {% else %}
                <a class="pag-item{{ desktopOnlyClass }}" href="{{ item.url }}">{{ item.number }}</a>
            {% endif %}
        {% endfor %}
    </nav>
{% endmacro %}
