{% macro render(
        text="",
        type="button",
        href="#",
        target="",
        rel="",
        id="",
        name="",
        value="",
        disabled=false,
        variant="",
        class="",
        icon="",
        data={},
        aria={}
    ) %}
    {# variant: "" (синяя) | "red" | "outline"; type: "button" | "submit" | "reset" | "link" #}
    {% set buttonClasses = "button" %}
    {% if variant %}
        {% set buttonClasses = buttonClasses + " " + variant %}
    {% endif %}
    {% if class %}
        {% set buttonClasses = buttonClasses + " " + class %}
    {% endif %}

    {% if type == "link" %}
        <a
            class="{{ buttonClasses }}{% if disabled %} disabled{% endif %}"
            {% if id %}id="{{ id }}"{% endif %}
            href="{{ href }}"
            {% if target %}target="{{ target }}"{% endif %}
            {% if rel %}rel="{{ rel }}"{% endif %}
            {% if data %}
                {% for key, val in data %}
                    data-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if aria %}
                {% for key, val in aria %}
                    aria-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
        >
            {% if text %}
                <span>{{ text }}</span>
            {% endif %}
            {% if icon %}{{ icon | safe }}{% endif %}
            {% if caller %}{{ caller() }}{% endif %}
        </a>
    {% else %}
        <button
            class="{{ buttonClasses }}"
            {% if id %}id="{{ id }}"{% endif %}
            type="{{ type }}"
            {% if name %}name="{{ name }}"{% endif %}
            {% if value %}value="{{ value }}"{% endif %}
            {% if data %}
                {% for key, val in data %}
                    data-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if aria %}
                {% for key, val in aria %}
                    aria-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if disabled %}disabled{% endif %}
        >
            {% if text %}
                <span>{{ text }}</span>
            {% endif %}
            {% if icon %}{{ icon | safe }}{% endif %}
            {% if caller %}{{ caller() }}{% endif %}
        </button>
    {% endif %}
{% endmacro %}