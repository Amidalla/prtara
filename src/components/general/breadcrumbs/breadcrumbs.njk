{% macro render(
        items=[],
        separator="line",
        size="md",
        ariaLabel="Цепочка навигации",
        class=""
    ) %}
    {% set breadcrumbsClasses = "breadcrumbs " + size %}
    {% if class %}
        {% set breadcrumbsClasses = breadcrumbsClasses + " " + class %}
    {% endif %}

    {% set backHref = items[((items | length) - 2)].url if (items | length >= 2 and items[((items | length) - 2)].url) else "./home.html" %}

    <nav class="{{ breadcrumbsClasses }}" aria-label="{{ ariaLabel }}">
        <div class="container">
            <a class="back" href="{{ backHref }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path
                        d="M11 4L5.80417 8.76285C5.3718 9.15918 5.3718 9.84082 5.80417 10.2372L11 15"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    />
                </svg>
                <span>Назад</span>
            </a>

            <ul class="list" itemscope itemtype="https://schema.org/BreadcrumbList">
                {% for item in items %}
                    <li class="item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        {% if item.url %}
                            <a
                                href="{{ item.url }}"
                                class="link"
                                itemprop="item"
                                {% if item.title %}title="{{ item.title }}"{% endif %}
                            >
                                <span itemprop="name">{{ item.title }}</span>
                            </a>
                        {% else %}
                            <span class="current-page" aria-current="page" itemprop="name">{{ item.title }}</span>
                        {% endif %}
                        <meta itemprop="position" content="{{ loop.index }}" />

                        {% if not loop.last %}
                            <span class="separator {{ separator }}" aria-hidden="true">
                                {% if separator == "chevron" %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 9 9" fill="none">
                                        <path d="M3 2L6 5L3 8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                {% elif separator == "slash" %}/
                                {% elif separator == "arrow" %}→
                                {% elif separator == "line" %}—
                                {% else %}•
                                {% endif %}
                            </span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </nav>
{% endmacro %}
