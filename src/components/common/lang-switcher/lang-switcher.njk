{#
  Переключатель языков под модуль Битрикс redslash.translatorjs.
  Логику перевода не подключаем — только разметка с data-translatorjs-lang.
#}
{% macro render(
        languages=[
            { code: "ru", label: "RU", current: true },
            { code: "en", label: "EN" }
        ],
        class="",
        id="lang-switcher-list"
    ) %}
    {% set rootClasses = "lang-switcher notranslate" %}
    {% if class %}
        {% set rootClasses = rootClasses + " " + class %}
    {% endif %}

    {% set currentLanguage = languages | selectattr("current") | first %}
    {% if not currentLanguage %}
        {% set currentLanguage = languages[0] %}
    {% endif %}

    <div class="{{ rootClasses }}" data-lang-switcher translate="no">
        <button
            class="lang-switcher-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="{{ id }}"
            aria-label="Выбор языка"
        >
            <span class="lang-switcher-current">{{ currentLanguage.label }}</span>
            <svg class="lang-switcher-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                 <path d="M9.75932 12.1142C9.36022 12.5798 8.6399 12.5798 8.2408 12.1142L4.41499 7.6508C3.85897 7.00213 4.31988 6 5.17424 6L12.8258 6C13.6801 6 14.1411 7.00211 13.5851 7.65079L9.75932 12.1142Z" fill="white"></path>
            </svg>
        </button>
        <ul class="lang-switcher-list" id="{{ id }}" hidden>
            {% for language in languages %}
                <li>
                    <button
                        class="lang-switcher-item{{ ' is-active' if language.current else '' }}"
                        type="button"
                        data-translatorjs-lang="{{ language.code }}"
                    >
                        {{ language.label }}
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}
