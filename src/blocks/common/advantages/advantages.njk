{% set advantagesItems = [
    {
        title: "Металл всегда в наличии",
        text: "Не нужно ждать поставок, мы приступаем сразу после поступления заказа, выполняем без задержек"
    },
    {
        title: "Работаем со всеми видами металла",
        text: "от тонкой листовой стали и алюминия до твердого инструментального металла и титана"
    },
    { title: "Полный цикл металлообработки", text: "От разработки чертежей до серийного производства" },
    { title: "Собственное производство", text: "Более 50 станков в эксплуатации. Более 25 000 выполненных заказов." }
] %}

<section class="advantages section">
    <div class="container">
        <div class="advantages-inner">
            <div class="content">
                <h2>Металлообработка любой сложности</h2>
                <div class="text">
                    <p>
                        Мы оперируем собственным производственным комплексом, на котором изготавливаются элементы.
                        Именно поэтому фирма гарантирует длительный срок эксплуатации готовой продукции, её надежность и
                        прочность.
                    </p>
                </div>
                <div class="actions">
                    {{ button(
                        text="Запросить КП",
                        data={ src: "popup-callback" },
                        icon=buttonIcon()
                    ) }}
                </div>
            </div>
            <ul class="list">
                {% for item in advantagesItems %}
                    <li class="item">
                        <div class="icon">{{ advantagesIcon | safe }}</div>
                        <div class="name">{{ item.title }}</div>
                        <div class="desc">{{ item.text }}</div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>