{% from "components/general/button/button.njk" import render as button %}

{% set lazyPlaceholder = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E" %}
{% set deliveryPageTitle = deliveryPageTitle | default("Доставка и оплата") %}
{% set deliveryPageMapImage = deliveryPageMapImage | default("./assets/images/content/delivery/map.png") %}
{% set deliveryPageMapAlt = deliveryPageMapAlt | default("Схема проезда к складу Промрегионтара") %}
{% set deliveryPageMapHref = deliveryPageMapHref | default("https://yandex.ru/maps/?rtext=~56.338260,38.161062") %}
{% set deliveryPagePhones = deliveryPagePhones | default([
    { href: "tel:+74965413663", text: "8 (496)541-36-63" },
    { href: "tel:+74965492041", text: "8 (496)549-20-41" },
    { href: "tel:+79852599289", text: "8(985)259-92-89" }
]) %}
{% set deliveryPageEmail = deliveryPageEmail | default("info@prtara.ru") %}
{% set deliveryPageEmailHref = deliveryPageEmailHref | default("mailto:info@prtara.ru") %}

{% if not deliveryPageLeadHtml %}
    {% set deliveryPageLeadHtml %}
        <p>Доставка в любой регион России!</p>
        <p><strong>БЕСПЛАТНО доставим по Москве и Московской области</strong></p>
    {% endset %}
{% endif %}

{% if not deliveryPageDeliveryHtml %}
    {% set deliveryPageDeliveryHtml %}
        <p>
            Доставка осуществляется по всей территории России с привлечением транспортных компаний.<br>
            По Москве и Московской области доставка бесплатная. Сроки и способ доставки согласуются при оформлении заказа.
        </p>
        <p>
            <strong>
                Оформить заказ можно с понедельника по пятницу<br>
                с 9:00 до 17:00 — по электронной почте или по телефону.
            </strong>
        </p>
    {% endset %}
{% endif %}

{% if not deliveryPageOrderHtml %}
    {% set deliveryPageOrderHtml %}
        <ul>
            <li>
                <span>Шаг 1:</span> Выберите в каталоге нужные типы упаковки, перейдите в карточку товара и кликнете на кнопку “заказать”.
            </li>
            <li>
                <span>Шаг 2:</span> В открывшейся форме обратной связи укажите необходимое количество (от 100 шт) и размер.
            </li>
            <li>
                <span>Шаг 3:</span> Заполните данные получателя (ФИО, телефон, адрес доставки).
            </li>
            <li>
                <span>Шаг 4:</span> После обработки заказа, по указанным данным (электронная. почта) с вами свяжется менеджер для уточнения данных и времени доставки.
            </li>
            <li>
                <span>Шаг 5:</span> На ваш эл. ящик будет направлен договор и указанный в договоре способ оплаты (<a href="#payment">см.варианты оплаты ↓</a>).
            </li>
            <li>
                <span>Шаг 6:</span> Доставка в указанные срок от 2 дней, зависимости от удалённости пункта назначения.
            </li>
        </ul>
    {% endset %}
{% endif %}

{% if not deliveryPagePickupHtml %}
    {% set deliveryPagePickupHtml %}
        <ul>
            <li>Со склада, г. Сергиев Посад, Московская обл., Ярославское ш., 4Б.</li>
            <li>C пн. – пт.: с 9:00 до 17:00.</li>
            <li>Срок готовности заказа — через 2 часа после подтверждения.</li>
        </ul>
    {% endset %}
{% endif %}

{% if not deliveryPagePaymentHtml %}
    {% set deliveryPagePaymentHtml %}
        <h3>Способы оплаты</h3>
        <p>
            Условия оплаты согласовываются индивидуально и фиксируются в договоре — мы учитываем особенности работы каждого клиента.
        </p>
        <ul>
            <li>
                Для юридических лиц: безналичный расчет по выставленному счету (без НДС), счет формируется при оформлении через менеджера.
            </li>
        </ul>
    {% endset %}
{% endif %}

<section class="delivery-page section is-page-head">
    <div class="container">
        <h1 class="title">{{ deliveryPageTitle }}</h1>

        <div class="delivery-page-layout">
            <div class="delivery-page-content">
                <div class="delivery-page-lead">
                    <span class="delivery-page-lead-icon" aria-hidden="true">
                        <img
                            src="./assets/images/content/delivery/truck.svg"
                            alt=""
                            width="75"
                            height="72"
                        />
                    </span>
                    <div class="delivery-page-lead-text">
                        {{ deliveryPageLeadHtml | safe }}
                    </div>
                </div>

                <div class="delivery-page-block">
                    <h2>Доставка</h2>
                    <div class="delivery-page-text">
                        {{ deliveryPageDeliveryHtml | safe }}
                    </div>

                    <div class="delivery-page-contacts">
                        <div class="delivery-page-contact">
                            <span class="delivery-page-contact-icon" aria-hidden="true">
                                <img
                                    src="./assets/images/content/delivery/phone.svg"
                                    alt=""
                                    width="24"
                                    height="24"
                                />
                            </span>
                            <p>
                                {% for item in deliveryPagePhones %}
                                    <a href="{{ item.href }}">{{ item.text }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                        <div class="delivery-page-contact">
                            <span class="delivery-page-contact-icon" aria-hidden="true">
                                <img
                                    src="./assets/images/content/delivery/email.svg"
                                    alt=""
                                    width="24"
                                    height="24"
                                />
                            </span>
                            <a href="{{ deliveryPageEmailHref }}">{{ deliveryPageEmail }}</a>
                        </div>
                    </div>

                    <div class="delivery-page-actions">
                        {{ button(
                            text="Заказать звонок",
                            type="button",
                            data={ src: "popup-callback" }
                        ) }}
                        {{ button(
                            text="Сделать заказ",
                            type="button",
                            variant="red",
                            data={ src: "popup-order" }
                        ) }}
                    </div>
                </div>

                <div class="delivery-page-block">
                    <h3>Как оформить заказ на сайте</h3>
                    <div class="delivery-page-text delivery-page-steps">
                        {{ deliveryPageOrderHtml | safe }}
                    </div>
                </div>

                <div class="delivery-page-block">
                    <h3>Самовывоз</h3>
                    <div class="delivery-page-text">
                        {{ deliveryPagePickupHtml | safe }}
                    </div>

                    <div class="delivery-page-route">
                        <p>Схема проезда</p>
                        <a href="{{ deliveryPageMapHref }}" target="_blank" rel="noopener noreferrer">
                            <span class="delivery-page-route-icon" aria-hidden="true">
                                <img
                                    src="./assets/images/content/delivery/pin.png"
                                    alt=""
                                    width="37"
                                    height="37"
                                />
                            </span>
                            <span>Составить маршрут на Yandex картах</span>
                        </a>
                    </div>

                    <div class="delivery-page-map">
                        <img
                            class="lazy"
                            src="{{ lazyPlaceholder }}"
                            data-src="{{ deliveryPageMapImage }}"
                            alt="{{ deliveryPageMapAlt }}"
                            width="707"
                            height="507"
                        />
                    </div>
                </div>

                <div class="delivery-page-block" id="payment">
                    <h2>Оплата</h2>
                    <div class="delivery-page-text">
                        {{ deliveryPagePaymentHtml | safe }}
                    </div>
                </div>
            </div>

            {% set catalogShortFormId = "delivery-help" %}
            {% set catalogShortFormTitle = "Нужна помощь? Задайте свой вопрос!" %}
            {% include "blocks/common/catalog-short/catalog-short-form.njk" %}
        </div>
    </div>
</section>
