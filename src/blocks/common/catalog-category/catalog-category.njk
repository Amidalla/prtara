{% set lazyPlaceholder = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E" %}

{% set catalogCategoryItemsDefault = [
    {
        title: "Пленки полиэтиленовые ПСД",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-1.png"
    },
    {
        title: "Пакеты ПСД",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-2.png"
    },
    {
        title: "Пленки полиэтиленовые пнд",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-3.png"
    },
    {
        title: "Пакеты пнд",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-4.png"
    },
    {
        title: "Пакеты пнд",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-5.png"
    },
    {
        title: "Пакеты пвд",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-6.png"
    },
    {
        title: "Пленки термоусадочная",
        href: "./product.html",
        image: "./assets/images/content/catalog-category/sub-7.png"
    }
] %}
{% set catalogCategoryItems = catalogCategoryItems if catalogCategoryItems else catalogCategoryItemsDefault %}
{% set catalogCategoryTitle = catalogCategoryTitle | default("Пленки и пакеты из полиэтилена") %}
{% if not catalogCategoryTextHtml %}
    {% set catalogCategoryTextHtml %}
        <h2>Мы предлагаем широкий ассортимент полиэтиленовой упаковки:</h2>

        <ul>
            <li>
                <span>Пленки: </span>
                <strong>полотно, рукав, полурукав, термоусадочную пленку.</strong>
            </li>
            <li>
                <span>Готовые изделия: </span>
                <strong>мешки и пакеты.</strong>
            </li>
        </ul>

        <p>Работаем с полиэтиленом высокого (ПВД), низкого (ПНД) и среднего (ПСД) давления.</p>
        <p>
            Наши мешки и пакеты изготавливаются с боковым и донным швом, доступны в любых размерах, включая
            нестандартные. Наносим флексопечать до 6 цветов для брендирования вашей продукции.
        </p>
    {% endset %}
{% endif %}

<section class="catalog-category section is-page-head">
    <div class="container">
        <h1 class="title">{{ catalogCategoryTitle }}</h1>

        <div class="catalog-category-grid">
            {% for item in catalogCategoryItems %}
                <a class="catalog-category-card" href="{{ item.href }}">
                    <span class="name">{{ item.title }}</span>
                    <span class="picture">
                        <img
                            class="lazy"
                            src="{{ lazyPlaceholder }}"
                            data-src="{{ item.image }}"
                            alt="{{ item.title }}"
                            width="238"
                            height="207"
                        />
                    </span>
                    <span class="arrow" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path
                                d="M2.39133 21.4587L21.3792 2.61136M21.3792 17.7476L21.3792 2.61136L5.58201 2.61135"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </a>
            {% endfor %}
        </div>

        {% if catalogCategoryTextHtml %}
            <div class="catalog-category-text">
                {{ catalogCategoryTextHtml | safe }}
            </div>
        {% endif %}
    </div>
</section>
