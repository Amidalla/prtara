{% set catalogShortItems = [
    {
        title: "Пленки и пакеты из полиэтилена",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short1.jpg"
    },
    {
        title: "Короба и листы из гофрокартона",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short2.jpg"
    },
    {
        title: "Фольга",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short3.jpg"
    },
    {
        title: "Рулонная упаковка",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short4.jpg"
    },
    {
        title: "Паллетная упаковка",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short5.jpg"
    },
    {
        title: "Пленки и пакеты БОПП",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short6.jpg"
    },
    {
        title: "Упаковка из вспененного полиэтилена",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short7.jpg"
    },
    {
        title: "Пленки защитные",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short8.jpg"
    },
    {
        title: "Другие виды упаковки",
        href: "./catalog-category.html",
        image: "./assets/images/content/catalog-short9.jpg"
    }
] %}

{% set lazyPlaceholder = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E" %}

{% set catalogShortTitleTag = catalogShortTitleTag | default("h2") %}
{% set catalogShortTitle = catalogShortTitle | default("Каталог") %}
{% set catalogShortFormId = catalogShortFormId | default("catalog-short") %}
{% set catalogShortIsPage = catalogShortIsPage | default(false) %}
{% set catalogShortHideForm = catalogShortHideForm | default(false) %}

<section
    class="catalog-short section{% if catalogShortIsPage %} is-page is-page-head{% endif %}{% if catalogShortHideForm %} is-cards-only{% endif %}"
    data-catalog-short
>
    <div class="container">
        {% if catalogShortTitleTag == "h1" %}
            <h1 class="title">{{ catalogShortTitle }}</h1>
        {% else %}
            <h2 class="title">{{ catalogShortTitle }}</h2>
        {% endif %}

        <div class="catalog-short-inner{% if catalogShortHideForm %} is-cards-only{% endif %}">
            {% if catalogShortHideForm %}
                <div class="catalog-short-slider" role="region" aria-label="Варианты упаковки">
                    <button class="nav prev" type="button" aria-label="Назад">
                        <svg xmlns="http://www.w3.org/2000/svg" width="77" height="42" viewBox="0 0 77 42" fill="none" aria-hidden="true">
                            <g clip-path="url(#catalog-short-nav-arrow-prev)">
                                <rect
                                    class="nav-circle"
                                    x="-0.75"
                                    y="0.75"
                                    width="40.5"
                                    height="40.5"
                                    rx="20.25"
                                    transform="matrix(-1 0 0 1 40.5 0)"
                                    fill="#F2F2F2"
                                    stroke="#fff"
                                    stroke-width="1.5"
                                />
                                <path class="nav-line" d="M75 21H11" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                <path class="nav-accent" d="M77 21H42" stroke="#B52F59" stroke-width="1.5" stroke-linejoin="round" />
                                <path class="nav-chevron" d="M21 32L10 21L21 10" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </g>
                            <defs>
                                <clipPath id="catalog-short-nav-arrow-prev">
                                    <rect width="77" height="42" fill="white" />
                                </clipPath>
                            </defs>
                        </svg>
                    </button>

                    <div class="swiper">
                        <div class="swiper-wrapper">
                            {% for item in catalogShortItems %}
                                <div class="swiper-slide">
                                    <a class="catalog-short-card catalog-short-card--slider" href="{{ item.href }}">
                                        <span class="name">{{ item.title }}</span>
                                        <span class="picture">
                                            <img
                                                class="lazy"
                                                src="{{ lazyPlaceholder }}"
                                                data-src="{{ item.image }}"
                                                alt="{{ item.title }}"
                                                width="290"
                                                height="220"
                                            />
                                        </span>
                                        <span class="arrow" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path
                                                    d="M2.39133 21.4587L21.3792 2.61136M21.3792 17.7476L21.3792 2.61136L5.58201 2.61135"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                />
                                            </svg>
                                        </span>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="swiper-pagination"></div>
                    </div>

                    <button class="nav next" type="button" aria-label="Вперёд">
                        <svg xmlns="http://www.w3.org/2000/svg" width="77" height="42" viewBox="0 0 77 42" fill="none" aria-hidden="true">
                            <g clip-path="url(#catalog-short-nav-arrow-next)">
                                <rect
                                    class="nav-circle"
                                    x="0.75"
                                    y="-0.75"
                                    width="40.5"
                                    height="40.5"
                                    rx="20.25"
                                    transform="matrix(1 8.74228e-08 8.74228e-08 -1 35 40.5)"
                                    fill="#F2F2F2"
                                    stroke="#fff"
                                    stroke-width="1.5"
                                />
                                <path class="nav-line" d="M2 21L66 21" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                <path class="nav-accent" d="M0 21L35 21" stroke="#B52F59" stroke-width="1.5" stroke-linejoin="round" />
                                <path class="nav-chevron" d="M56 10L67 21L56 32" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </g>
                            <defs>
                                <clipPath id="catalog-short-nav-arrow-next">
                                    <rect width="77" height="42" fill="white" transform="translate(77 42) rotate(-180)" />
                                </clipPath>
                            </defs>
                        </svg>
                    </button>
                </div>
            {% else %}
                <div class="catalog-short-grid">
                    {% for item in catalogShortItems %}
                        <a class="catalog-short-card" href="{{ item.href }}">
                            <span class="name">{{ item.title }}</span>
                            <span class="picture">
                                <img
                                    class="lazy"
                                    src="{{ lazyPlaceholder }}"
                                    data-src="{{ item.image }}"
                                    alt="{{ item.title }}"
                                    width="290"
                                    height="220"
                                />
                            </span>
                            <span class="arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M2.39133 21.4587L21.3792 2.61136M21.3792 17.7476L21.3792 2.61136L5.58201 2.61135"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </span>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {% if not catalogShortHideForm %}
                {% include "blocks/common/catalog-short/catalog-short-form.njk" %}
            {% endif %}
        </div>
    </div>
</section>
