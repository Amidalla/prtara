{% from "components/general/button/button.njk" import render as button %}
{% from "components/general/input/input.njk" import render as input %}
{% from "components/general/textarea/textarea.njk" import render as textarea %}
{% from "components/general/consent-checkbox/consent-checkbox.njk" import render as consentCheckbox %}

{% set catalogShortFormId = catalogShortFormId | default("catalog-short") %}
{% set catalogShortFormTitle = catalogShortFormTitle | default("Оставить заявку") %}

<aside class="catalog-short-form">
    <h3 class="form-title">{{ catalogShortFormTitle }}</h3>

    <form class="form" data-validate>
        <div class="grid">
            <div class="field">
                <label class="label" for="{{ catalogShortFormId }}-name">Контактное лицо*:</label>
                {{ input(
                    type="text",
                    id=catalogShortFormId + "-name",
                    name="name",
                    placeholder="ФИО",
                    autocomplete="name",
                    required=true,
                    minlength="2",
                    data={"error": "Введите имя (минимум 2 буквы)"}
                ) }}
            </div>
            <div class="field">
                <label class="label" for="{{ catalogShortFormId }}-phone">Телефон*:</label>
                {{ input(
                    type="tel",
                    id=catalogShortFormId + "-phone",
                    name="phone",
                    placeholder="+7",
                    autocomplete="tel",
                    data={"mask": "phone", "error": "Введите полный номер телефона"},
                    required=true
                ) }}
            </div>
            <div class="field">
                <label class="label" for="{{ catalogShortFormId }}-message">Сообщение</label>
                {{ textarea(
                    id=catalogShortFormId + "-message",
                    name="message",
                    placeholder="Текст сообщения",
                    rows=3,
                    data={"error": "Введите сообщение"}
                ) }}
            </div>
            <div class="field-consent">
                {{ consentCheckbox(
                    id=catalogShortFormId + "-consent",
                    text='Я согласен(а) на обработку моих персональных данных в соответствии с <a href="./policy.html">Согласием на обработку персональных данных</a> и <a href="./policy.html">Политикой конфиденциальности</a>',
                    data={"error": "Необходимо отметить"},
                    required=true
                ) }}
            </div>
            <div class="actions">
                {{ button(
                    text="Отправить",
                    type="submit",
                    disabled=true
                ) }}
            </div>
        </div>
    </form>
</aside>
