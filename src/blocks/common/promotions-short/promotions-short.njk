{% from "components/general/button/button.njk" import render as button %}

{% if not promotionsShortItems %}
    {% set promotionsShortItems = [
        {
            title: "Мешки полиэтиленовые ПСД для упаковки стиральных машин с",
            image: "./assets/images/content/promotions-short/promo-1.png",
            href: "./product.html",
            badge: true
        },
        {
            title: "Пленка полиэтиленовая термоусадочная, с флексопечатью",
            image: "./assets/images/content/promotions-short/promo-2.png",
            href: "./product.html",
            badge: true
        },
        {
            title: "Наименование товара",
            image: "./assets/images/content/promotions-short/promo-3.png",
            href: "./product.html",
            badge: true
        },
        {
            title: "Наименование товара",
            image: "./assets/images/content/promotions-short/promo-4.png",
            href: "./product.html",
            badge: true
        },
        {
            title: "Мешки полиэтиленовые ПСД для упаковки стиральных машин с",
            image: "./assets/images/content/promotions-short/promo-1.png",
            href: "./product.html",
            badge: true
        },
        {
            title: "Пленка полиэтиленовая термоусадочная, с флексопечатью",
            image: "./assets/images/content/promotions-short/promo-2.png",
            href: "./product.html",
            badge: true
        }
    ] %}
{% endif %}

{% set promotionsShortTitle = promotionsShortTitle | default("Акции") %}
{% set promotionsShortShowAll = promotionsShortShowAll | default(true) %}
{% set promotionsShortNavId = promotionsShortNavId | default("promotions-short") %}

{% set promotionsShortIsPage = promotionsShortIsPage | default(false) %}

<section class="promotions-short section{% if promotionsShortIsPage %} is-page{% endif %}" data-promotions-short>
    <div class="container">
        <div class="promotions-short-head">
            <h2 class="title">{{ promotionsShortTitle }}</h2>
            {% if promotionsShortShowAll %}
                <a class="all-link" href="./promotions.html">Все акции</a>
            {% endif %}
        </div>

        <div class="promotions-short-slider">
            <button class="nav prev" type="button" aria-label="Назад">
                <svg xmlns="http://www.w3.org/2000/svg" width="77" height="42" viewBox="0 0 77 42" fill="none" aria-hidden="true">
                    <g clip-path="url(#{{ promotionsShortNavId }}-arrow-prev)">
                        <rect
                            class="nav-circle"
                            x="-0.75"
                            y="0.75"
                            width="40.5"
                            height="40.5"
                            rx="20.25"
                            transform="matrix(-1 0 0 1 40.5 0)"
                            fill="#F2F2F2"
                            stroke="#fff"
                            stroke-width="1.5"
                        />
                        <path class="nav-line" d="M75 21H11" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path class="nav-accent" d="M77 21H42" stroke="#B52F59" stroke-width="1.5" stroke-linejoin="round" />
                        <path class="nav-chevron" d="M21 32L10 21L21 10" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </g>
                    <defs>
                        <clipPath id="{{ promotionsShortNavId }}-arrow-prev">
                            <rect width="77" height="42" fill="white" />
                        </clipPath>
                    </defs>
                </svg>
            </button>

            <div class="swiper">
                <div class="swiper-wrapper">
                    {% for item in promotionsShortItems %}
                        <div class="swiper-slide">
                            <article class="promo-card">
                                <a class="picture" href="{{ item.href }}">
                                    {% if item.badge %}
                                        <span class="badge" aria-hidden="true">
                                            <img
                                                src="./assets/images/content/promotions-short/badge-star.svg"
                                                width="64"
                                                height="64"
                                                alt=""
                                            >
                                            <span class="badge-text">%</span>
                                        </span>
                                    {% endif %}

                                    <img
                                        class="lazy"
                                        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                                        data-src="{{ item.image }}"
                                        alt="{{ item.title }}"
                                    >
                                </a>

                                <div class="body">
                                    <h3 class="name">
                                        <a href="{{ item.href }}">{{ item.title }}</a>
                                    </h3>

                                    <div class="actions">
                                        {{ button(
                                            text="Заказать",
                                            type="button",
                                            data={ src: "popup-order" }
                                        ) }}
                                        <a class="more" href="{{ item.href }}">Подробнее</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
            </div>

            <button class="nav next" type="button" aria-label="Вперёд">
                <svg xmlns="http://www.w3.org/2000/svg" width="77" height="42" viewBox="0 0 77 42" fill="none" aria-hidden="true">
                    <g clip-path="url(#{{ promotionsShortNavId }}-arrow-next)">
                        <rect
                            class="nav-circle"
                            x="0.75"
                            y="-0.75"
                            width="40.5"
                            height="40.5"
                            rx="20.25"
                            transform="matrix(1 8.74228e-08 8.74228e-08 -1 35 40.5)"
                            fill="#F2F2F2"
                            stroke="#fff"
                            stroke-width="1.5"
                        />
                        <path class="nav-line" d="M2 21L66 21" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path class="nav-accent" d="M0 21L35 21" stroke="#B52F59" stroke-width="1.5" stroke-linejoin="round" />
                        <path class="nav-chevron" d="M56 10L67 21L56 32" stroke="#134A9B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </g>
                    <defs>
                        <clipPath id="{{ promotionsShortNavId }}-arrow-next">
                            <rect width="77" height="42" fill="white" transform="translate(77 42) rotate(-180)" />
                        </clipPath>
                    </defs>
                </svg>
            </button>
        </div>
    </div>
</section>
