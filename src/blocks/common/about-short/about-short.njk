{% from "components/general/button/button.njk" import render as button %}

{% set aboutShortCertificates = [
    {
        image: "./assets/images/content/about-short/certificate-1.png",
        alt: "Сертификат участника RosUpack 2025"
    },
    {
        image: "./assets/images/content/about-short/certificate-2.png",
        alt: "Сертификат и патент"
    },
    {
        image: "./assets/images/content/about-short/certificate-1.png",
        alt: "Сертификат участника RosUpack 2025"
    },
    {
        image: "./assets/images/content/about-short/certificate-2.png",
        alt: "Сертификат и патент"
    }
] %}
{% set aboutShortTitle = aboutShortTitle | default("О нас") %}
{% set aboutShortBgImage = aboutShortBgImage | default("./assets/images/content/about-short/about-short-bg.jpg") %}
{% set aboutShortLead = aboutShortLead | default("Компания&nbsp;ООО «Промрегионтара»&nbsp;создана весной 2004 года, специализируется на комплексных поставках упаковочных материалов по всей России.") %}
{% set aboutShortDetailHref = aboutShortDetailHref | default("./about.html") %}
{% set aboutShortCertsHref = aboutShortCertsHref | default("./certificates.html") %}
{% set aboutShortMailLabel = aboutShortMailLabel | default("Пишите нам на эл. почту:") %}
{% set aboutShortMailText = aboutShortMailText | default("info@prtara.ru") %}
{% set aboutShortMailHref = aboutShortMailHref | default("mailto:info@prtara.ru") %}
{% set aboutShortPromoDate = aboutShortPromoDate | default("С&nbsp;16 по 19 июня") %}
{% set aboutShortPromoTitle = aboutShortPromoTitle | default("Выставка RosUpack 2026!") %}
{% set aboutShortPromoTitleAside = aboutShortPromoTitleAside | default("Выставка RosUpack<br>2026!") %}
{% set aboutShortPromoHref = aboutShortPromoHref | default("./promotions.html") %}
{% set aboutShortCertsTitle = aboutShortCertsTitle | default("Сертификаты и патенты") %}
{% set aboutShortDeliveryIcon = aboutShortDeliveryIcon | default("./assets/images/content/about-short/delivery-icon.svg") %}
{% set aboutShortDeliveryTextHtml = aboutShortDeliveryTextHtml | default("Доставка в любой регион России!") %}
{% set aboutShortDeliveryAccentHtml = aboutShortDeliveryAccentHtml | default("<strong>БЕСПЛАТНО доставим по Москве и Московской области</strong>") %}
{% if not aboutShortBodyHtml %}
    {% set aboutShortBodyHtml %}
        <p>Имеет зарегистрированный&nbsp;<strong>Товарный знак</strong>&nbsp;№&nbsp;528607.</p>
        <div class="about-short-list-block">
            <p>Мы поставляем нашим заказчикам надежную упаковку:</p>
            <ul>
                <li>пленка полиэтиленовая (ПВД, ПСД, ПНД);</li>
                <li>мешки и пакеты упаковочные;</li>
                <li>рулонная упаковка;</li>
                <li>фольга алюминиевая;</li>
                <li>пленка защитная;</li>
                <li>пленка полиолефиниловая;</li>
                <li>стрейч пленка, термоусадочная пленка;</li>
                <li>защитные уголки из прессованного картона;</li>
                <li>упаковка из гофрокартона и другие упаковочные материалы.</li>
                <li>лента упаковочная полипропиленовая;</li>
                <li>и другие упаковочные материалы.</li>
            </ul>
        </div>
        <p>
            Компания получила&nbsp;патент&nbsp;на уникальную технологию изготовления изделий из пленки ПНД,
            имеет награды и дипломы выставок «РосУпак», «Краснодарэкспо», «Логистика и склад»,
            «Modern Bakery», «Upakexpo», «Продэкспо», «RosBuild-2024», «ChemiCos».
        </p>
    {% endset %}
{% endif %}

<section class="about-short section" data-about-short>
    <div class="about-short-bg" aria-hidden="true">
        <img
            class="lazy"
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            data-src="{{ aboutShortBgImage }}"
            alt=""
        >
        <div class="about-short-overlay"></div>
    </div>

    <div class="container">
        <div class="about-short-panel">
            <div class="about-short-content">
                <h2 class="title">{{ aboutShortTitle }}</h2>

                <div class="about-short-richtext">
                    <p class="about-short-lead">{{ aboutShortLead | safe }}</p>
                    <div class="about-short-body">
                        {{ aboutShortBodyHtml | safe }}
                    </div>
                </div>

                <div class="about-short-actions">
                    {{ button(
                        text="Подробнее",
                        type="link",
                        href=aboutShortDetailHref
                    ) }}
                    <p class="about-short-mail">
                        <span>{{ aboutShortMailLabel }}</span>
                        <a href="{{ aboutShortMailHref }}">{{ aboutShortMailText }}</a>
                    </p>
                </div>

                <div class="about-short-compact">
                    {{ button(
                        text="Сертификаты",
                        type="link",
                        href=aboutShortCertsHref,
                        variant="outline",
                        class="about-short-certs-link"
                    ) }}

                    <div class="about-short-promo">
                        <div class="promo-text">
                            <p class="promo-date">{{ aboutShortPromoDate | safe }}</p>
                            <p class="promo-title">{{ aboutShortPromoTitle | safe }}</p>
                        </div>
                        {{ button(
                            text="Подробнее",
                            type="link",
                            href=aboutShortPromoHref,
                            variant="red"
                        ) }}
                    </div>
                </div>
            </div>

            <aside class="about-short-aside">
                <div class="about-short-certs">
                    <h3 class="certs-title">{{ aboutShortCertsTitle }}</h3>

                    <div class="about-short-slider">
                        <div class="swiper">
                            <div class="swiper-wrapper">
                                {% for cert in aboutShortCertificates %}
                                    <div class="swiper-slide">
                                        <a
                                            class="cert-card"
                                            href="{{ cert.image }}"
                                            data-fancybox="about-short-certs"
                                            data-thumb="{{ cert.image }}"
                                            data-caption="{{ cert.alt }}"
                                        >
                                            <span class="cert-image">
                                                <img
                                                    class="lazy"
                                                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                                                    data-src="{{ cert.image }}"
                                                    alt="{{ cert.alt }}"
                                                >
                                            </span>
                                            <span class="cert-zoom" aria-hidden="true">
                                                <img
                                                    src="./assets/images/content/about-short/zoom-icon.svg"
                                                    width="70"
                                                    height="70"
                                                    alt=""
                                                >
                                            </span>
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="swiper-pagination"></div>
                    </div>
                </div>

                <div class="about-short-promo">
                    <div class="promo-text">
                        <p class="promo-date">{{ aboutShortPromoDate | safe }}</p>
                        <p class="promo-title">{{ aboutShortPromoTitleAside | safe }}</p>
                    </div>
                    {{ button(
                        text="Подробнее",
                        type="link",
                        href=aboutShortPromoHref,
                        variant="red"
                    ) }}
                </div>
            </aside>
        </div>

        <div class="about-short-delivery">
            <img
                class="delivery-icon"
                src="{{ aboutShortDeliveryIcon }}"
                width="75"
                height="72"
                alt=""
            >
            <div class="delivery-text">
                <p>{{ aboutShortDeliveryTextHtml | safe }}</p>
                <p>{{ aboutShortDeliveryAccentHtml | safe }}</p>
            </div>
        </div>
    </div>
</section>
