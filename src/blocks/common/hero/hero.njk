{% from "components/general/button/button.njk" import render as button %}
{% from "components/general/icons/button-icon.njk" import render as buttonIcon %}

{% set heroSlides = [
    {
        title: "Профессиональная металлообработка",
        items: [
            "Стоимость от 5 руб/кг.",
            "Специальное предложение для больших партий",
            "Полный спектр услуг от 3D моделей до серийного производства"
        ],
        image: "./assets/images/content/hero/hero-img.png",
        imageAlt: "Металлическая деталь",
        button: { text: "Расчет стоимости работ", popup: "popup-callback" }
    },
    {
        title: "Профессиональная металлообработка",
        items: [
            "Стоимость от 5 руб/кг.",
            "Специальное предложение для больших партий",
            "Полный спектр услуг от 3D моделей до серийного производства"
        ],
        image: "./assets/images/content/hero/hero-img1.png",
        imageAlt: "Металлическая деталь",
        button: { text: "Расчет стоимости работ", popup: "popup-callback" }
    },
    {
        title: "Реализованные проекты",
        items: [
            "Токарная и фрезерная обработка деталей любой сложности",
            "Серийное производство по вашим чертежам и 3D-моделям",
            "Более 500 выполненных заказов для промышленности"
        ],
        image: "./assets/images/content/hero/hero-img2.png",
        imageAlt: "Готовые металлические детали",
        button: { text: "Смотреть наши работы", type: "link", href: "./works.html" }
    }
] %}

<section class="hero" data-hero>
    <h1 class="visually-hidden">Профессиональная металлообработка</h1>
    <div class="swiper">
        <div class="swiper-wrapper">
            {% for slide in heroSlides %}
                <div class="swiper-slide">
                    <div class="hero-slide">
                        <div class="container">
                            <div class="hero-slide-inner">
                                <div class="content">
                                    <p class="title">{{ slide.title }}</p>
                                    {% if slide.items %}
                                        <ul class="list">
                                            {% for item in slide.items %}
                                                <li>{{ item }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    {% if slide.button %}
                                        <div class="actions">
                                            {% if slide.button.type == "link" %}
                                                {{ button(
                                                    text=slide.button.text,
                                                    type="link",
                                                    href=slide.button.href or "#",
                                                    target=slide.button.target or "",
                                                    rel=slide.button.rel or "",
                                                    icon=buttonIcon()
                                                ) }}
                                            {% else %}
                                                {{ button(
                                                    text=slide.button.text,
                                                    data={ src: slide.button.popup or "popup-callback" },
                                                    icon=buttonIcon()
                                                ) }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="media">
                                    <img
                                        class="lazy"
                                        src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E"
                                        data-src="{{ slide.image }}"
                                        alt="{{ slide.imageAlt }}"
                                        width="720"
                                        height="560"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
    </div>
</section>