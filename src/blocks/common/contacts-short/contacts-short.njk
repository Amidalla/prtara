                <form class="form contacts-short-form" data-validate>
                    <div class="grid">
                        <div class="field">
                            <label class="label" for="contacts-short-name">Ваше имя</label>
                            {{ input(
                                type="text",
                                id="contacts-short-name",
                                name="name",
                                placeholder="Ваше имя",
                                autocomplete="name",
                                required=true,
                                minlength="2",
                                data={"error": "Введите имя (минимум 2 буквы)"}
                            ) }}
                        </div>
                        <div class="field">
                            <label class="label" for="contacts-short-phone">Ваш телефон</label>
                            {{ input(
                                type="tel",
                                id="contacts-short-phone",
                                name="phone",
                                placeholder="Ваш телефон",
                                autocomplete="tel",
                                data={"mask": "phone", "error": "Введите полный номер телефона"},
                                required=true
                            ) }}
                        </div>
                        <div class="field field-message">
                            <label class="label" for="contacts-short-message">Сообщение</label>
                            {{ textarea(
                                id="contacts-short-message",
                                name="message",
                                placeholder="Сообщение",
                                rows=1,
                                data={"error": "Введите сообщение"}
                            ) }}
                        </div>
                        <div class="field-consent">
                            {{ consentCheckbox(
                                id="contacts-short-consent",
                                text='Я согласен(-на) на обработку <a href="./policy.html">Персональных данных</a>',
                                data={"error": "Необходимо отметить"},
                                required=true
                            ) }}
                        </div>
                        <div class="actions">
                            {{ button(
                                text="Отправить",
                                type="submit",
                                disabled=true,
                                icon=buttonIcon()
                            ) }}
                        </div>
                    </div>
                </form>
