{% from "components/general/navigation-top/navigation-top.njk" import render as navigationTop %}
{% from "components/general/logo/logo.njk" import render as logo %}
{% from "components/general/button/button.njk" import render as button %}
{% from "components/common/lang-switcher/lang-switcher.njk" import render as langSwitcher %}
{% from "components/common/catalog-menu/catalog-menu.njk" import render as catalogMenu %}
{% from "components/general/socials/socials.njk" import render as socials %}

{% set productsIcon %}
    <span class="products-icon" aria-hidden="true">
        <svg class="products-icon-default" xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 23 23" fill="none">
            <rect width="11.25" height="11.25" fill="white" />
            <rect width="11.25" height="11.25" transform="translate(11.25 11.25)" fill="white" />
            <rect width="5.625" height="5.625" transform="translate(2.8125 14.0625)" fill="#B52F59" />
            <rect width="5.625" height="5.625" transform="translate(14.0625 2.8125)" fill="#B52F59" />
        </svg>
        <svg class="products-icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <rect width="9.375" height="9.375" transform="translate(9.375 10) rotate(90)" fill="#134A9B" />
            <rect width="9.375" height="9.375" transform="translate(19.3749) rotate(90)" fill="#134A9B" />
            <rect width="4.6875" height="4.6875" transform="translate(17.3959 11.6667) rotate(90)" fill="#B52F59" />
            <rect width="4.6875" height="4.6875" transform="translate(6.5625 2.5) rotate(90)" fill="#B52F59" />
        </svg>
    </span>
{% endset %}

<header class="header">
    <div class="header-top">
        <div class="container">
            <div class="header-top-inner">
                <div class="header-top-left">
                    <div class="header-address">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path
                                d="M12.0009 13.4299C13.724 13.4299 15.1209 12.0331 15.1209 10.3099C15.1209 8.58681 13.724 7.18994 12.0009 7.18994C10.2777 7.18994 8.88086 8.58681 8.88086 10.3099C8.88086 12.0331 10.2777 13.4299 12.0009 13.4299Z"
                                stroke="currentColor"
                                stroke-width="1.5"
                            />
                            <path
                                d="M3.61971 8.49C5.58971 -0.169998 18.4197 -0.159997 20.3797 8.5C21.5297 13.58 18.3697 17.88 15.5997 20.54C13.5897 22.48 10.4097 22.48 8.38971 20.54C5.62971 17.88 2.46971 13.57 3.61971 8.49Z"
                                stroke="currentColor"
                                stroke-width="1.5"
                            />
                        </svg>
                        <span>Россия, Московская область, г. Сергиев Посад</span>
                    </div>
                    <a class="header-email" href="mailto:info@prtara.ru">info@prtara.ru</a>
                    <div class="header-phones" data-header-phones>
                        <button class="header-phones-toggle" type="button" aria-expanded="false" aria-controls="header-phones-list">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                    d="M21.97 18.33C21.97 18.69 21.89 19.06 21.72 19.42C21.55 19.78 21.33 20.12 21.04 20.44C20.55 20.98 20.01 21.37 19.4 21.62C18.8 21.87 18.15 22 17.45 22C16.43 22 15.34 21.76 14.19 21.27C13.04 20.78 11.89 20.12 10.75 19.29C9.6 18.45 8.51 17.52 7.47 16.49C6.44 15.45 5.51 14.36 4.68 13.22C3.86 12.08 3.2 10.94 2.72 9.81C2.24 8.67 2 7.58 2 6.54C2 5.86 2.12 5.21 2.36 4.61C2.6 4 2.98 3.44 3.51 2.94C4.15 2.31 4.85 2 5.59 2C5.87 2 6.15 2.06 6.4 2.18C6.66 2.3 6.89 2.48 7.07 2.74L9.39 6.01C9.57 6.26 9.7 6.49 9.79 6.71C9.88 6.92 9.93 7.13 9.93 7.32C9.93 7.56 9.86 7.8 9.72 8.03C9.59 8.26 9.4 8.5 9.16 8.74L8.4 9.53C8.29 9.64 8.24 9.77 8.24 9.93C8.24 10.01 8.25 10.08 8.27 10.16C8.3 10.24 8.33 10.3 8.35 10.36C8.53 10.69 8.84 11.12 9.28 11.64C9.73 12.16 10.21 12.69 10.73 13.22C11.27 13.75 11.79 14.24 12.32 14.69C12.84 15.13 13.27 15.43 13.61 15.61C13.66 15.63 13.72 15.66 13.79 15.69C13.87 15.72 13.95 15.73 14.04 15.73C14.21 15.73 14.34 15.67 14.45 15.56L15.21 14.81C15.46 14.56 15.7 14.37 15.93 14.25C16.16 14.11 16.39 14.04 16.64 14.04C16.83 14.04 17.03 14.08 17.25 14.17C17.47 14.26 17.7 14.39 17.95 14.56L21.26 16.91C21.52 17.09 21.7 17.3 21.81 17.55C21.91 17.8 21.97 18.05 21.97 18.33Z"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-miterlimit="10"
                                />
                            </svg>
                            <span class="header-phones-text">
                                <span>+7 (496) 549-20-41</span><span class="header-phones-second">, +7 (985) 259-92-89</span>
                            </span>
                            <svg class="header-phones-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                              <path d="M9.75932 12.1142C9.36022 12.5798 8.6399 12.5798 8.2408 12.1142L4.41499 7.6508C3.85897 7.00213 4.31988 6 5.17424 6L12.8258 6C13.6801 6 14.1411 7.00211 13.5851 7.65079L9.75932 12.1142Z" fill="white"/>
                            </svg>
                        </button>
                        <ul class="header-phones-list" id="header-phones-list" hidden>
                            <li>
                                <a href="tel:+74965492041">+7 (496) 549-20-41</a>
                            </li>
                            <li>
                                <a href="tel:+79852599289">+7 (985) 259-92-89</a>
                            </li>
                            <li>
                                <a href="tel:+74965413663">+7 (496) 541-36-63</a>
                            </li>
                        </ul>
                    </div>
                    {{ button(
                         text="Заказать звонок",
                         type="button",
                         variant="outline light",
                         class="header-callback",
                         data={ src: "popup-callback" }
                     ) }}
                </div>
                <div class="header-top-right">
                    {{ socials(items=socialItems, class="header-socials", linkClass="header-soc-item", light=true) }}
                    {{ langSwitcher(
                        class="header-lang",
                        languages=[
                            { code: "ru", label: "RU", current: true },
                            { code: "en", label: "EN" }
                        ]
                    ) }}
                </div>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="container">
            <div class="header-main-inner">
                <div class="header-logo">
                    {{ logo(clipId="logo-clip-header") }}
                </div>
                <div class="header-nav">
                    <div class="header-catalog">
                        {{ button(
                            text="Продукция",
                            type="link",
                            href="./catalog.html",
                            class="header-products",
                            icon=productsIcon,
                            data={ toggle_catalog: true },
                            aria={ expanded: "false", controls: "mobile-catalog-menu" }
                        ) }}
                        {{ catalogMenu(items=catalogMenuItems, class="header-catalog-menu") }}
                    </div>
                    {{ navigationTop(items=headerNavItems) }}
                </div>
                <button class="menu-open" type="button" data-toggle="menu" aria-label="Открыть меню">
                    <span class="menu-open-text">Меню</span>
                    <span class="menu-open-icon" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>
                <form class="header-search" action="./search.html" method="get" role="search">
                    <label class="visually-hidden" for="header-search">Поиск продукции</label>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                            d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M20.9984 21.0004L16.6484 16.6504"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="square"
                            stroke-linejoin="round"
                        />
                    </svg>
                    <input
                        id="header-search"
                        type="search"
                        name="q"
                        placeholder="Найти продукцию по названию"
                        autocomplete="off"
                    />
                    <button class="header-search-clear" type="button" aria-label="Очистить поиск" hidden>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
