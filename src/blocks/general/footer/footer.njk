{% from "components/general/logo/logo.njk" import render as logo %}
{% from "components/general/button/button.njk" import render as button %}
{% from "components/common/catalog-menu/catalog-menu.njk" import render as catalogMenu %}
{% from "components/general/socials/socials.njk" import render as socials %}

<footer class="footer">
    <div class="footer-main">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    {{ logo(clipId="logo-clip-footer") }}
                    <button class="footer-to-top" type="button" data-scroll-top aria-label="Наверх">
                        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="21" viewBox="0 0 12 21" fill="none" aria-hidden="true">
                            <path d="M5.60971 20.1477V0.504883M0.252563 5.86203L5.60971 0.504883L11.324 6.21917" stroke="white" stroke-width="0.714286" />
                        </svg>
                    </button>
                </div>

                <div class="footer-content">
                    <div class="footer-contacts">
                        <div class="footer-contact-row">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                    d="M12.0009 13.4299C13.724 13.4299 15.1209 12.0331 15.1209 10.3099C15.1209 8.58681 13.724 7.18994 12.0009 7.18994C10.2777 7.18994 8.88086 8.58681 8.88086 10.3099C8.88086 12.0331 10.2777 13.4299 12.0009 13.4299Z"
                                    stroke="#808080"
                                    stroke-width="1.5"
                                />
                                <path
                                    d="M3.61971 8.49C5.58971 -0.169998 18.4197 -0.159997 20.3797 8.5C21.5297 13.58 18.3697 17.88 15.5997 20.54C13.5897 22.48 10.4097 22.48 8.38971 20.54C5.62971 17.88 2.46971 13.57 3.61971 8.49Z"
                                    stroke="#808080"
                                    stroke-width="1.5"
                                />
                            </svg>
                            <span>Россия, Московская обл., г. Сергиев Посад</span>
                        </div>
                        <div class="footer-contact-row">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                    d="M22 13C22 18.52 17.52 23 12 23C6.48 23 2 18.52 2 13C2 7.48 6.48 3 12 3C17.52 3 22 7.48 22 13Z"
                                    stroke="#808080"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M15.7128 16.1798L12.6128 14.3298C12.0728 14.0098 11.6328 13.2398 11.6328 12.6098V8.50977"
                                    stroke="#808080"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                            <span>Пн. – Пт.: с 9:00 до 17:00</span>
                        </div>
                        <div class="footer-contact-row footer-contact-row--phones">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                    d="M21.97 18.33C21.97 18.69 21.89 19.06 21.72 19.42C21.55 19.78 21.33 20.12 21.04 20.44C20.55 20.98 20.01 21.37 19.4 21.62C18.8 21.87 18.15 22 17.45 22C16.43 22 15.34 21.76 14.19 21.27C13.04 20.78 11.89 20.12 10.75 19.29C9.6 18.45 8.51 17.52 7.47 16.49C6.44 15.45 5.51 14.36 4.68 13.22C3.86 12.08 3.2 10.94 2.72 9.81C2.24 8.67 2 7.58 2 6.54C2 5.86 2.12 5.21 2.36 4.61C2.6 4 2.98 3.44 3.51 2.94C4.15 2.31 4.85 2 5.59 2C5.87 2 6.15 2.06 6.4 2.18C6.66 2.3 6.89 2.48 7.07 2.74L9.39 6.01C9.57 6.26 9.7 6.49 9.79 6.71C9.88 6.92 9.93 7.13 9.93 7.32C9.93 7.56 9.86 7.8 9.72 8.03C9.59 8.26 9.4 8.5 9.16 8.74L8.4 9.53C8.29 9.64 8.24 9.77 8.24 9.93C8.24 10.01 8.25 10.08 8.27 10.16C8.3 10.24 8.33 10.3 8.35 10.36C8.53 10.69 8.84 11.12 9.28 11.64C9.73 12.16 10.21 12.69 10.73 13.22C11.27 13.75 11.79 14.24 12.32 14.69C12.84 15.13 13.27 15.43 13.61 15.61C13.66 15.63 13.72 15.66 13.79 15.69C13.87 15.72 13.95 15.73 14.04 15.73C14.21 15.73 14.34 15.67 14.45 15.56L15.21 14.81C15.46 14.56 15.7 14.37 15.93 14.25C16.16 14.11 16.39 14.04 16.64 14.04C16.83 14.04 17.03 14.08 17.25 14.17C17.47 14.26 17.7 14.39 17.95 14.56L21.26 16.91C21.52 17.09 21.7 17.3 21.81 17.55C21.91 17.8 21.97 18.05 21.97 18.33Z"
                                    stroke="#808080"
                                    stroke-width="1.5"
                                    stroke-miterlimit="10"
                                />
                            </svg>
                            <div>
                                <a href="tel:+74965413663">8 (496) 541-36-63,</a>
                                <a href="tel:+74965492041">8 (496) 549-20-41,</a>
                                <a href="tel:+79852599289">8 (985) 259-92-89</a>
                            </div>
                        </div>
                        {{ button(text="Заказать звонок", type="button", class="footer-callback", data={ src: "popup-callback" }) }}
                    </div>

                    <div class="footer-socials">
                        {{ socials(items=socialItems, class="footer-socials-list") }}
                        <a class="footer-email" href="mailto:info@prtara.ru">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path
                                    d="M23.3496 18C23.3496 19.2957 22.2957 20.3496 21 20.3496H3C1.7043 20.3496 0.650391 19.2957 0.650391 18V9.54883L9.80957 16.4199C11.1094 17.3948 12.8906 17.3948 14.1904 16.4199L23.3496 9.54883V18ZM2.25 3.65039H21.75C22.6332 3.65039 23.3496 4.3668 23.3496 5.25C23.3496 5.75288 23.1134 6.22612 22.709 6.53027L12.5098 14.1797C12.2065 14.4048 11.7935 14.4048 11.4902 14.1797L1.29004 6.53027H1.29102C0.886586 6.22612 0.650391 5.75288 0.650391 5.25C0.650391 4.3668 1.3668 3.65039 2.25 3.65039Z"
                                    stroke="#808080"
                                    stroke-width="1.3"
                                />
                            </svg>
                            info@prtara.ru
                        </a>
                    </div>

                    <div class="footer-navigation">
                        <div class="footer-catalog">
                            <h2>Продукция</h2>
                            {{ catalogMenu(items=catalogMenuItems) }}
                        </div>

                        <div class="footer-menu">
                            <h2>Меню</h2>
                            <nav>
                                <a href="./about.html">О нас</a>
                                <a href="./certificates.html">Сертификаты</a>
                                <a href="./contacts.html">Контакты</a>
                                <a href="./delivery.html">Доставка и оплата</a>
                                <a href="./promotions.html">Акции</a>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container">
            <div class="footer-bottom-inner">
                <span>ООО “Промрегионтара” © 2026</span>
                <div class="footer-bottom-links">
                    <a href="./policy.html">Политика конфиденциальности</a>
                    <a href="./policy.html">Пользовательское соглашение</a>
                </div>
                <a href="https://artfactor.ru" target="_blank" rel="noopener noreferrer">Разработка Артфактор</a>
            </div>
        </div>
    </div>

    <div class="footer-accent" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="152" height="152" viewBox="0 0 152 152" fill="none">
            <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M86.8923 0H151.564V78.2633L78.601 151.221H0V86.8855H86.8923V0Z"
                fill="#134A9B"
            />
        </svg>
    </div>

    <button class="footer-chat" type="button" data-rasa-webchat aria-label="Открыть чат">
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="49" height="49" viewBox="0 0 49 49" fill="none" aria-hidden="true">
            <rect width="49" height="49" rx="24.5" fill="url(#footer-chat-pattern)" />
            <defs>
                <pattern id="footer-chat-pattern" patternContentUnits="objectBoundingBox" width="1" height="1">
                    <use xlink:href="#footer-chat-image" transform="translate(-0.103448 -0.0689655) scale(0.0172414)" />
                </pattern>
                <image
                    id="footer-chat-image"
                    width="69"
                    height="70"
                    preserveAspectRatio="none"
                    xlink:href="data:image/png;base64,"
                />
            </defs>
        </svg>
    </button>
</footer>
